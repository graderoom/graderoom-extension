{
  "name": "Graderoom",
  "description": "Graderoom extension",
  "version": "1.7.4",
  "manifest_version": 3,
  "action": {
    "default_icon": "icon.png",
    "default_state": "disabled"
  },
  "host_permissions": [
    "https://powerschool.bcp.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://powerschool.bcp.org/guardian/*"
      ],
      "js": [
        "psLogin.js"
      ]
    },
    {
      "matches": [
        "https://powerschool.bcp.org/public/*"
      ],
      "js": [
        "psPublic.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.graderoom.me/*"
    ]
  },
  "permissions": [
    "offscreen",
    "declarativeNetRequest"
  ]
}
